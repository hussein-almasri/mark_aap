rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function storePath(storeId) {
      return /databases/$(database)/documents/stores/$(storeId);
    }

    function storeUserPath(storeId, uid) {
      return /databases/$(database)/documents/stores/$(storeId)/users/$(uid);
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function validSetupBatch(storeId, uid) {
      let store = getAfter(storePath(storeId)).data;
      let member = getAfter(storeUserPath(storeId, uid)).data;
      let user = getAfter(userPath(uid)).data;

      return isSignedIn()
        && request.auth.uid == uid
        && !exists(storePath(storeId))
        && !exists(storeUserPath(storeId, uid))
        && !exists(userPath(uid))
        && existsAfter(storePath(storeId))
        && existsAfter(storeUserPath(storeId, uid))
        && existsAfter(userPath(uid))
        && store.ownerUid == uid
        && store.ownerName == user.name
        && member.storeId == storeId
        && member.name == user.name
        && member.email == user.email
        && member.role == 'ADMIN'
        && member.isActive == true
        && user.storeId == storeId
        && user.role == 'ADMIN'
        && user.isActive == true;
    }

    function isStoreMember(storeId) {
      let uid = request.auth.uid;
      let user = get(userPath(uid)).data;
      let member = get(storeUserPath(storeId, uid)).data;

      return isSignedIn()
        && exists(userPath(uid))
        && exists(storeUserPath(storeId, uid))
        && user.storeId == storeId
        && user.role in ['ADMIN', 'EMPLOYEE']
        && user.isActive == true
        && member.storeId == storeId
        && member.role == user.role
        && member.isActive == true;
    }

    match /stores/{storeId} {
      allow get: if isStoreMember(storeId);
      allow list: if false;
      allow create: if validSetupBatch(storeId, request.auth.uid)
        && request.resource.data == getAfter(storePath(storeId)).data;
      allow update, delete: if false;

      match /users/{uid} {
        allow get, list: if isStoreMember(storeId);
        allow create: if uid == request.auth.uid
          && validSetupBatch(storeId, uid)
          && request.resource.data == getAfter(storeUserPath(storeId, uid)).data;
        allow update: if uid == request.auth.uid
          && isStoreMember(storeId)
          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['name', 'email', 'updatedAt']);
        allow delete: if false;
      }
    }

    match /users/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow list: if false;
      allow create: if uid == request.auth.uid
        && validSetupBatch(request.resource.data.storeId, uid)
        && request.resource.data == getAfter(userPath(uid)).data;
      allow update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['name', 'email', 'updatedAt']);
      allow delete: if false;
    }
  }
}
