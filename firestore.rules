rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Common helpers ----------

    function isSignedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function membershipIndexPath(uid, storeId) {
      return /databases/$(database)/documents/users/$(uid)/memberships/$(storeId);
    }

    function storeUserPath(storeId, uid) {
      return /databases/$(database)/documents/stores/$(storeId)/users/$(uid);
    }

    function storePath(storeId) {
      return /databases/$(database)/documents/stores/$(storeId);
    }

    function storeJoinCodePath(codeId) {
      return /databases/$(database)/documents/storeJoinCodes/$(codeId);
    }

    function normalizedJoinCode(code) {
      return code.replace('-', '').lower();
    }

    function validJoinCodeFormat(code) {
      return code is string
        && code.matches('^[23456789ABCDEFGHJKLMNPQRSTUVWXYZ]{4}-[23456789ABCDEFGHJKLMNPQRSTUVWXYZ]{4}-[23456789ABCDEFGHJKLMNPQRSTUVWXYZ]{4}-[23456789ABCDEFGHJKLMNPQRSTUVWXYZ]{4}$');
    }

    function productPath(storeId, productId) {
      return /databases/$(database)/documents/stores/$(storeId)/products/$(productId);
    }

    function sellingPricePath(storeId, productId) {
      return /databases/$(database)/documents/stores/$(storeId)/productSellingPrices/$(productId);
    }

    function productCostPath(storeId, productId) {
      return /databases/$(database)/documents/stores/$(storeId)/productCosts/$(productId);
    }

    function priceHistoryPath(storeId, productId, priceType, revision) {
      return /databases/$(database)/documents/stores/$(storeId)/priceHistory/$(productId + '_' + priceType + '_' + string(revision));
    }

    function normalizedProductName(name) {
      return name.trim().lower();
    }

    function productNameKey(name) {
      return 'n_' + normalizedProductName(name).toUtf8().toBase64()
        .replace('/', '_').replace('[+]', '-').replace('=', '');
    }

    function productBarcodeKey(barcode) {
      return 'b_' + barcode.trim().toUtf8().toBase64()
        .replace('/', '_').replace('[+]', '-').replace('=', '');
    }

    function productNameKeyPath(storeId, name) {
      return /databases/$(database)/documents/stores/$(storeId)/productNameKeys/$(productNameKey(name));
    }

    function productBarcodeKeyPath(storeId, barcode) {
      return /databases/$(database)/documents/stores/$(storeId)/productBarcodeKeys/$(productBarcodeKey(barcode));
    }

    function normalizedCompanyName(name) {
      return name.trim().lower();
    }

    function companyNameKey(name) {
      return 'c_' + normalizedCompanyName(name).toUtf8().toBase64()
        .replace('/', '_').replace('[+]', '-').replace('=', '');
    }

    function companyNameKeyPath(storeId, name) {
      return /databases/$(database)/documents/stores/$(storeId)/companyNameKeys/$(companyNameKey(name));
    }

    function companyPath(storeId, companyId) {
      return /databases/$(database)/documents/stores/$(storeId)/companies/$(companyId);
    }

    function hasOnlyKeys(data, keys) {
      return data.keys().hasAll(keys) && data.keys().hasOnly(keys);
    }

    function validCompanyData(data) {
      return data.keys().hasAll([
          'name', 'isActive', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'name', 'phone', 'isActive', 'createdAt', 'updatedAt'
        ])
        && data.name is string
        && data.name == data.name.trim()
        && data.name.matches('.*\\S.*')
        && data.name.size() <= 120
        && (!data.keys().hasAny(['phone']) || data.phone is string)
        && data.isActive is bool;
    }

    function companyClaimMatches(claim, companyId, name) {
      return claim.companyId == companyId
        && claim.normalizedName == normalizedCompanyName(name);
    }

    function companyClaimExistsAfter(storeId, companyId, name) {
      let claimPath = companyNameKeyPath(storeId, name);
      let claim = getAfter(claimPath).data;

      return existsAfter(claimPath)
        && companyClaimMatches(claim, companyId, name);
    }

    function validCompanyCreate(storeId, companyId) {
      let data = request.resource.data;

      return isAdmin(storeId)
        && validCompanyData(data)
        && data.isActive == true
        && data.createdAt == request.time
        && data.updatedAt == request.time
        && companyClaimExistsAfter(storeId, companyId, data.name);
    }

    function validCompanyRename(storeId, companyId) {
      let oldName = resource.data.name;
      let newName = request.resource.data.name;
      let oldClaimPath = companyNameKeyPath(storeId, oldName);
      let oldClaim = get(oldClaimPath).data;

      return normalizedCompanyName(oldName) != normalizedCompanyName(newName)
        && exists(oldClaimPath)
        && companyClaimMatches(oldClaim, companyId, oldName)
        && !existsAfter(oldClaimPath)
        && companyClaimExistsAfter(storeId, companyId, newName);
    }

    function validCompanyClaimPreserved(storeId, companyId, name) {
      let claimPath = companyNameKeyPath(storeId, name);
      let claim = get(claimPath).data;
      let claimAfter = getAfter(claimPath).data;

      return exists(claimPath)
        && companyClaimMatches(claim, companyId, name)
        && existsAfter(claimPath)
        && companyClaimMatches(claimAfter, companyId, name);
    }

    function validCompanyUpdate(storeId, companyId) {
      let oldName = resource.data.name;
      let newName = request.resource.data.name;

      return isAdmin(storeId)
        && validCompanyData(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'phone', 'isActive', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && (normalizedCompanyName(oldName) == normalizedCompanyName(newName)
          ? validCompanyClaimPreserved(storeId, companyId, oldName)
          : validCompanyRename(storeId, companyId));
    }

    function validCompanyClaimCreateForNewCompany(storeId, companyId) {
      let companyRef = companyPath(storeId, companyId);
      let company = getAfter(companyRef).data;

      return !exists(companyRef)
        && existsAfter(companyRef)
        && validCompanyData(company)
        && company.isActive == true
        && company.createdAt == request.time
        && company.updatedAt == request.time
        && companyClaimMatches(request.resource.data, companyId, company.name);
    }

    function validCompanyClaimCreateForRename(storeId, companyId) {
      let companyRef = companyPath(storeId, companyId);
      let companyBefore = get(companyRef).data;
      let companyAfter = getAfter(companyRef).data;
      let oldClaimPath = companyNameKeyPath(storeId, companyBefore.name);
      let oldClaim = get(oldClaimPath).data;

      return exists(companyRef)
        && existsAfter(companyRef)
        && validCompanyData(companyAfter)
        && companyAfter.updatedAt == request.time
        && normalizedCompanyName(companyBefore.name)
          != normalizedCompanyName(companyAfter.name)
        && exists(oldClaimPath)
        && companyClaimMatches(oldClaim, companyId, companyBefore.name)
        && !existsAfter(oldClaimPath)
        && companyClaimMatches(
          request.resource.data, companyId, companyAfter.name
        );
    }

    function validCompanyNameClaimCreate(storeId, key) {
      return isAdmin(storeId)
        && hasOnlyKeys(request.resource.data, ['companyId', 'normalizedName'])
        && request.resource.data.companyId is string
        && request.resource.data.normalizedName is string
        && request.resource.data.normalizedName
          == normalizedCompanyName(request.resource.data.normalizedName)
        && key == companyNameKey(request.resource.data.normalizedName)
        && (validCompanyClaimCreateForNewCompany(
              storeId, request.resource.data.companyId
            )
          || validCompanyClaimCreateForRename(
              storeId, request.resource.data.companyId
            ));
    }

    function validCompanyNameClaimDelete(storeId, key) {
      let companyId = resource.data.companyId;
      let companyRef = companyPath(storeId, companyId);
      let companyBefore = get(companyRef).data;
      let companyAfter = getAfter(companyRef).data;
      let oldName = resource.data.normalizedName;
      let newClaimPath = companyNameKeyPath(storeId, companyAfter.name);
      let newClaim = getAfter(newClaimPath).data;

      return isAdmin(storeId)
        && resource.data.keys().hasAll(['companyId', 'normalizedName'])
        && resource.data.keys().hasOnly(['companyId', 'normalizedName'])
        && companyId is string
        && oldName is string
        && oldName == normalizedCompanyName(oldName)
        && key == companyNameKey(oldName)
        && exists(companyRef)
        && existsAfter(companyRef)
        && normalizedCompanyName(companyBefore.name) == oldName
        && normalizedCompanyName(companyAfter.name) != oldName
        && validCompanyData(companyAfter)
        && companyAfter.updatedAt == request.time
        && existsAfter(newClaimPath)
        && companyClaimMatches(newClaim, companyId, companyAfter.name);
    }

    function validHistoryData(data) {
      return hasOnlyKeys(data, [
          'productId', 'priceType', 'price', 'revision', 'createdBy', 'createdAt'
        ])
        && data.productId is string
        && data.priceType in ['PURCHASE', 'SELLING']
        && data.price is int
        && data.revision is int
        && data.revision > 0
        && data.createdBy == request.auth.uid
        && data.createdAt == request.time
        && (data.priceType == 'PURCHASE'
          ? data.price >= 0
          : data.price > 0);
    }

    function validInitialProduct(storeId, productId) {
      let data = request.resource.data;
      let selling = getAfter(sellingPricePath(storeId, productId)).data;
      let cost = getAfter(productCostPath(storeId, productId)).data;
      let sellingHistory = getAfter(priceHistoryPath(
        storeId, productId, 'SELLING', 1
      )).data;
      let purchaseHistory = getAfter(priceHistoryPath(
        storeId, productId, 'PURCHASE', 1
      )).data;
      let nameClaim = getAfter(productNameKeyPath(storeId, data.name)).data;
      let barcodeClaim = getAfter(productBarcodeKeyPath(storeId, data.barcode)).data;

      return isAdmin(storeId)
        && hasOnlyKeys(data, ['name', 'barcode', 'createdAt', 'updatedAt'])
        && data.name is string
        && data.name == data.name.trim()
        && data.name.matches('.*\\S.*')
        && data.name.size() <= 120
        && data.barcode is string
        && data.barcode != ''
        && data.barcode == data.barcode.trim()
        && data.barcode.size() <= 128
        && data.createdAt == request.time
        && data.updatedAt == request.time
        && hasOnlyKeys(selling, ['sellingPrice', 'revision', 'updatedAt', 'updatedBy'])
        && selling.sellingPrice is int
        && selling.sellingPrice > 0
        && selling.revision == 1
        && selling.updatedAt == request.time
        && selling.updatedBy == request.auth.uid
        && hasOnlyKeys(cost, ['purchasePrice', 'revision', 'updatedAt', 'updatedBy'])
        && cost.purchasePrice is int
        && cost.purchasePrice >= 0
        && cost.revision == 1
        && cost.updatedAt == request.time
        && cost.updatedBy == request.auth.uid
        && validHistoryData(sellingHistory)
        && sellingHistory.productId == productId
        && sellingHistory.priceType == 'SELLING'
        && sellingHistory.price == selling.sellingPrice
        && sellingHistory.revision == 1
        && validHistoryData(purchaseHistory)
        && purchaseHistory.productId == productId
        && purchaseHistory.priceType == 'PURCHASE'
        && purchaseHistory.price == cost.purchasePrice
        && purchaseHistory.revision == 1
        && hasOnlyKeys(nameClaim, ['productId', 'normalizedName'])
        && nameClaim.productId == productId
        && nameClaim.normalizedName == normalizedProductName(data.name)
        && hasOnlyKeys(barcodeClaim, ['productId', 'barcode'])
        && barcodeClaim.productId == productId
        && barcodeClaim.barcode == data.barcode;
    }

    function validNameClaimCreate(storeId, key) {
      let productId = request.resource.data.productId;
      let product = getAfter(productPath(storeId, productId)).data;

      return isAdmin(storeId)
        && hasOnlyKeys(request.resource.data, ['productId', 'normalizedName'])
        && product.name is string
        && key == productNameKey(product.name)
        && request.resource.data.normalizedName == normalizedProductName(product.name);
    }

    function validBarcodeClaimCreate(storeId, key) {
      let productId = request.resource.data.productId;
      let product = getAfter(productPath(storeId, productId)).data;

      return isAdmin(storeId)
        && hasOnlyKeys(request.resource.data, ['productId', 'barcode'])
        && product.barcode is string
        && key == productBarcodeKey(product.barcode)
        && request.resource.data.barcode == product.barcode;
    }

    function validProductNameClaimAfter(storeId, productId, oldName, newName) {
      let newClaim = getAfter(productNameKeyPath(storeId, newName)).data;
      return newClaim.productId == productId
        && newClaim.normalizedName == normalizedProductName(newName)
        && (productNameKey(oldName) == productNameKey(newName)
          || !existsAfter(productNameKeyPath(storeId, oldName)));
    }

    function validProductBarcodeClaimAfter(storeId, productId, oldBarcode, newBarcode) {
      let newClaim = getAfter(productBarcodeKeyPath(storeId, newBarcode)).data;
      return newClaim.productId == productId
        && newClaim.barcode == newBarcode
        && (productBarcodeKey(oldBarcode) == productBarcodeKey(newBarcode)
          || !existsAfter(productBarcodeKeyPath(storeId, oldBarcode)));
    }

    function validPriceHistoryLink(storeId, historyId, data) {
      let product = getAfter(productPath(storeId, data.productId)).data;
      let selling = getAfter(sellingPricePath(storeId, data.productId)).data;
      let cost = getAfter(productCostPath(storeId, data.productId)).data;
      let event = getAfter(priceHistoryPath(
        storeId, data.productId, data.priceType, data.revision
      )).data;

      return validHistoryData(data)
        && historyId == data.productId + '_' + data.priceType + '_' + string(data.revision)
        && hasOnlyKeys(event, [
          'productId', 'priceType', 'price', 'revision', 'createdBy', 'createdAt'
        ])
        && event.productId == data.productId
        && event.priceType == data.priceType
        && event.price == data.price
        && event.revision == data.revision
        && event.createdBy == request.auth.uid
        && event.createdAt == request.time
        && product.name is string
        && (data.priceType == 'SELLING'
          ? selling.sellingPrice == data.price
            && selling.revision == data.revision
            && selling.updatedAt == request.time
            && selling.updatedBy == request.auth.uid
          : cost.purchasePrice == data.price
            && cost.revision == data.revision
            && cost.updatedAt == request.time
            && cost.updatedBy == request.auth.uid);
    }

    function isValidInitialSetup(uid) {
      let storeData = getAfter(/databases/$(database)/documents/stores/$(uid)).data;
      let storeMembership = getAfter(storeUserPath(uid, uid)).data;
      let userData = getAfter(userPath(uid)).data;
      let membershipIndex = getAfter(membershipIndexPath(uid, uid)).data;
      let joinCode = storeData.joinCode is string ? storeData.joinCode : '';
      let joinCodeClaim = getAfter(
        storeJoinCodePath(normalizedJoinCode(joinCode))
      ).data;

      return isSignedIn()
        && request.auth.uid == uid
        // Each target must be new before this atomic setup batch.
        && !exists(userPath(uid))
        && !exists(/databases/$(database)/documents/stores/$(uid))
        && !exists(storeUserPath(uid, uid))
        && !exists(membershipIndexPath(uid, uid))
        // All four deterministic documents must exist after the batch.
        && existsAfter(/databases/$(database)/documents/stores/$(uid))
        && existsAfter(storeUserPath(uid, uid))
        && existsAfter(userPath(uid))
        && existsAfter(membershipIndexPath(uid, uid))
        && storeData.keys().hasAll([
          'name', 'ownerUid', 'joinCode', 'createdAt', 'updatedAt'
        ])
        && storeData.keys().hasOnly([
          'name', 'ownerUid', 'joinCode', 'createdAt', 'updatedAt'
        ])
        && storeData.name is string
        && storeData.name.matches('.*\\S.*')
        && storeData.name.size() <= 120
        && storeData.ownerUid == request.auth.uid
        && validJoinCodeFormat(joinCode)
        && hasOnlyKeys(joinCodeClaim, ['storeId', 'createdAt'])
        && joinCodeClaim.storeId == uid
        && joinCodeClaim.createdAt == request.time
        && storeData.createdAt == request.time
        && storeData.updatedAt == request.time
        && storeMembership.keys().hasAll([
          'uid', 'role', 'isActive', 'createdAt', 'updatedAt'
        ])
        && storeMembership.keys().hasOnly([
          'uid', 'role', 'isActive', 'createdAt', 'updatedAt'
        ])
        && storeMembership.uid == request.auth.uid
        && storeMembership.role == 'ADMIN'
        && storeMembership.isActive == true
        && storeMembership.createdAt == request.time
        && storeMembership.updatedAt == request.time
        && userData.keys().hasAll([
          'uid', 'email', 'displayName', 'createdAt', 'updatedAt'
        ])
        && userData.keys().hasOnly([
          'uid', 'email', 'displayName', 'createdAt', 'updatedAt'
        ])
        && userData.uid == request.auth.uid
        && userData.email is string
        && userData.email == request.auth.token.email
        && userData.displayName is string
        && userData.displayName.matches('.*\\S.*')
        && userData.displayName.size() <= 120
        && userData.createdAt == request.time
        && userData.updatedAt == request.time
        && membershipIndex.keys().hasAll(['storeId', 'role', 'isActive'])
        && membershipIndex.keys().hasOnly(['storeId', 'role', 'isActive'])
        && membershipIndex.storeId == request.auth.uid
        && membershipIndex.role == 'ADMIN'
        && membershipIndex.isActive == true;
    }

    function validEmployeeRegistration(uid, storeId) {
      let userData = getAfter(userPath(uid)).data;
      let indexData = getAfter(membershipIndexPath(uid, storeId)).data;
      let storeMember = getAfter(storeUserPath(storeId, uid)).data;
      let joinCodeId = indexData.joinCodeId;
      let claimPath = storeJoinCodePath(joinCodeId);

      return isSignedIn()
        && request.auth.uid == uid
        && !exists(userPath(uid))
        && !exists(membershipIndexPath(uid, storeId))
        && !exists(storeUserPath(storeId, uid))
        && existsAfter(userPath(uid))
        && existsAfter(membershipIndexPath(uid, storeId))
        && existsAfter(storeUserPath(storeId, uid))
        && hasOnlyKeys(userData, [
          'uid', 'email', 'displayName', 'storeId', 'createdAt', 'updatedAt'
        ])
        && userData.uid == uid
        && userData.email is string
        && userData.email == request.auth.token.email
        && userData.displayName is string
        && userData.displayName.matches('.*\\S.*')
        && userData.displayName.size() <= 120
        && userData.storeId == storeId
        && userData.createdAt == request.time
        && userData.updatedAt == request.time
        && hasOnlyKeys(indexData, [
          'storeId', 'role', 'isActive', 'joinCodeId'
        ])
        && indexData.storeId == storeId
        && indexData.role == 'EMPLOYEE'
        && indexData.isActive == true
        && joinCodeId is string
        && joinCodeId.matches('^[23456789abcdefghjklmnpqrstuvwxyz]{16}$')
        && exists(claimPath)
        && get(claimPath).data.storeId == storeId
        && hasOnlyKeys(storeMember, [
          'uid', 'role', 'isActive', 'createdAt', 'updatedAt'
        ])
        && storeMember.uid == uid
        && storeMember.role == 'EMPLOYEE'
        && storeMember.isActive == true
        && storeMember.createdAt == request.time
        && storeMember.updatedAt == request.time;
    }

    function validJoinCodeClaimCreate(codeId) {
      let data = request.resource.data;
      let storeId = data.storeId;
      let storeAfter = getAfter(storePath(storeId)).data;
      let code = storeAfter.joinCode is string ? storeAfter.joinCode : '';

      return isSignedIn()
        && codeId.matches('^[23456789abcdefghjklmnpqrstuvwxyz]{16}$')
        && hasOnlyKeys(data, ['storeId', 'createdAt'])
        && data.storeId is string
        && data.createdAt == request.time
        && storeAfter.ownerUid == request.auth.uid
        && validJoinCodeFormat(code)
        && normalizedJoinCode(code) == codeId
        && ((!exists(storePath(storeId))
            && storeId == request.auth.uid)
          || (exists(storePath(storeId)) && isAdmin(storeId)));
    }

    function validJoinCodeClaimDelete(codeId) {
      let storeId = resource.data.storeId;
      let storeBefore = get(storePath(storeId)).data;
      let storeAfter = getAfter(storePath(storeId)).data;
      let newCode = storeAfter.joinCode is string ? storeAfter.joinCode : '';
      let newClaim = getAfter(
        storeJoinCodePath(normalizedJoinCode(newCode))
      ).data;

      return isAdmin(storeId)
        && storeBefore.ownerUid == request.auth.uid
        && validJoinCodeFormat(storeBefore.joinCode)
        && normalizedJoinCode(storeBefore.joinCode) == codeId
        && validJoinCodeFormat(newCode)
        && normalizedJoinCode(newCode) != codeId
        && hasOnlyKeys(newClaim, ['storeId', 'createdAt'])
        && newClaim.storeId == storeId
        && newClaim.createdAt == request.time;
    }

    function validStoreJoinCodeUpdate(storeId) {
      let newCode = request.resource.data.joinCode is string
        ? request.resource.data.joinCode
        : '';
      let newClaim = getAfter(
        storeJoinCodePath(normalizedJoinCode(newCode))
      ).data;
      let oldCodeExists = resource.data.keys().hasAny(['joinCode']);
      let oldCode = oldCodeExists && resource.data.joinCode is string
        ? resource.data.joinCode
        : '';

      return resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && validJoinCodeFormat(newCode)
        && (!oldCodeExists
          || (validJoinCodeFormat(oldCode)
            && normalizedJoinCode(oldCode) != normalizedJoinCode(newCode)
            && !existsAfter(storeJoinCodePath(normalizedJoinCode(oldCode)))))
        && hasOnlyKeys(newClaim, ['storeId', 'createdAt'])
        && newClaim.storeId == storeId
        && newClaim.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function isStoreMember(storeId) {
      return isSignedIn()
        && exists(userPath(request.auth.uid))
        && exists(membershipIndexPath(request.auth.uid, storeId))
        && exists(storeUserPath(storeId, request.auth.uid))
        && get(membershipIndexPath(request.auth.uid, storeId)).data.storeId == storeId
        && get(membershipIndexPath(request.auth.uid, storeId)).data.isActive == true
        && get(storeUserPath(storeId, request.auth.uid)).data.uid == request.auth.uid
        && get(storeUserPath(storeId, request.auth.uid)).data.isActive == true;
    }

    function isAdmin(storeId) {
      return isStoreMember(storeId)
        && get(storeUserPath(storeId, request.auth.uid)).data.role == 'ADMIN';
    }

    function isEmployeeManagementAdmin(storeId) {
      return isAdmin(storeId)
        && get(membershipIndexPath(request.auth.uid, storeId)).data.role == 'ADMIN'
        && get(storePath(storeId)).data.ownerUid == request.auth.uid;
    }

    function validStoreEmployeeStatusUpdate(storeId, uid) {
      let indexPath = membershipIndexPath(uid, storeId);
      let indexBefore = get(indexPath).data;
      let indexAfter = getAfter(indexPath).data;

      return isEmployeeManagementAdmin(storeId)
        && uid != get(storePath(storeId)).data.ownerUid
        && resource.data.uid == uid
        && resource.data.role == 'EMPLOYEE'
        && resource.data.isActive is bool
        && request.resource.data.uid == uid
        && request.resource.data.role == 'EMPLOYEE'
        && request.resource.data.isActive is bool
        && request.resource.data.isActive != resource.data.isActive
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['isActive'])
        && exists(indexPath)
        && indexBefore.storeId == storeId
        && indexBefore.role == 'EMPLOYEE'
        && indexBefore.isActive is bool
        && indexAfter.storeId == storeId
        && indexAfter.role == 'EMPLOYEE'
        && indexAfter.isActive is bool
        && indexAfter.isActive == request.resource.data.isActive
        && indexBefore.isActive != indexAfter.isActive;
    }

    function validEmployeeIndexStatusUpdate(uid, storeId) {
      let storeMembershipPath = storeUserPath(storeId, uid);
      let storeMembershipBefore = get(storeMembershipPath).data;
      let storeMembershipAfter = getAfter(storeMembershipPath).data;

      return isEmployeeManagementAdmin(storeId)
        && uid != get(storePath(storeId)).data.ownerUid
        && resource.data.storeId == storeId
        && resource.data.role == 'EMPLOYEE'
        && resource.data.isActive is bool
        && request.resource.data.storeId == storeId
        && request.resource.data.role == 'EMPLOYEE'
        && request.resource.data.isActive is bool
        && request.resource.data.isActive != resource.data.isActive
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['isActive'])
        && exists(storeMembershipPath)
        && storeMembershipBefore.uid == uid
        && storeMembershipBefore.role == 'EMPLOYEE'
        && storeMembershipBefore.isActive is bool
        && storeMembershipAfter.uid == uid
        && storeMembershipAfter.role == 'EMPLOYEE'
        && storeMembershipAfter.isActive is bool
        && storeMembershipAfter.isActive == request.resource.data.isActive
        && storeMembershipBefore.isActive != storeMembershipAfter.isActive;
    }

    function isSameStoreEmployeeProfileRead(uid) {
      let storeId = resource.data.storeId;
      let membershipPath = storeUserPath(storeId, uid);

      return storeId is string
        && isEmployeeManagementAdmin(storeId)
        && exists(membershipPath)
        && get(membershipPath).data.uid == uid
        && get(membershipPath).data.role == 'EMPLOYEE';
    }

    // Join-code claims are opaque lookup documents. Clients may check one
    // exact code but cannot enumerate the collection or edit an existing claim.
    match /storeJoinCodes/{codeId} {
      allow get: if true;
      allow list: if false;
      allow create: if validJoinCodeClaimCreate(codeId);
      allow update: if false;
      allow delete: if validJoinCodeClaimDelete(codeId);
    }

    // ---------- Global user ----------

    match /users/{uid} {
      // Users read their own account; a store owner Admin may read only
      // profiles of employees whose profile and store membership match.
      allow get: if isSignedIn()
        && (request.auth.uid == uid
          || isSameStoreEmployeeProfileRead(uid));

      allow list: if false;

      // Temporary Spark setup uses the Auth UID as storeId so this rule can
      // validate all four batch documents at deterministic paths. A future
      // trusted Cloud Function may use independent store IDs.
      allow create: if isValidInitialSetup(uid)
        || validEmployeeRegistration(uid, request.resource.data.storeId);

      // Users may update only their own display information.
      // Store role/status is NOT kept here.
      allow update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'displayName',
            'email',
            'updatedAt'
          ]);

      allow delete: if false;


      // ---------- Membership index ----------

      match /memberships/{storeId} {
        // The client may read its own membership index entry.
        allow get: if isSignedIn()
          && request.auth.uid == uid
          && resource.data.storeId == storeId;

        // The parent path limits this query to the signed-in user's index.
        allow list: if isSignedIn()
          && request.auth.uid == uid;

        // Initial setup is the only client creation path; future backend
        // operations may manage memberships after moving off Spark.
        allow create: if (storeId == request.auth.uid
            && isValidInitialSetup(uid))
          || validEmployeeRegistration(uid, storeId);
        allow update: if validEmployeeIndexStatusUpdate(uid, storeId);
        allow delete: if false;
      }
    }


    // ---------- Stores ----------

    match /stores/{storeId} {
      // Any active member may read the store itself.
      allow get: if isStoreMember(storeId);

      allow list: if false;

      // Temporary Spark setup uses the Auth UID as the store ID. A future
      // trusted Cloud Function may generate an independent store ID.
      allow create: if storeId == request.auth.uid
        && isValidInitialSetup(storeId);

      // Only Admin may update store data.
      allow update: if isAdmin(storeId)
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'name',
            'updatedAt',
            'joinCode'
          ])
        && (!request.resource.data.diff(resource.data)
            .affectedKeys().hasAny(['joinCode'])
          || validStoreJoinCodeUpdate(storeId));

      allow delete: if false;


      // ---------- Store memberships ----------

      match /users/{uid} {
        // Employees may read only their own membership, even while inactive.
        // The store owner Admin may read employee memberships in this store.
        allow get: if isSignedIn()
          && ((request.auth.uid == uid)
            || (isEmployeeManagementAdmin(storeId)
              && resource.data.uid == uid
              && resource.data.role == 'EMPLOYEE'));

        // The query must constrain results to employee memberships.
        allow list: if isEmployeeManagementAdmin(storeId)
          && resource.data.role == 'EMPLOYEE';

        // Allow only the membership created together with initial setup.
        allow create: if (storeId == request.auth.uid
            && uid == request.auth.uid
            && isValidInitialSetup(uid))
          || validEmployeeRegistration(uid, storeId);
        allow update: if validStoreEmployeeStatusUpdate(storeId, uid);
        allow delete: if false;
      }

      // ---------- Companies ----------

      match /companies/{companyId} {
        allow get: if isAdmin(storeId)
          || (isStoreMember(storeId)
            && get(storeUserPath(storeId, request.auth.uid)).data.role
              == 'EMPLOYEE'
            && resource.data.isActive == true);

        allow list: if isAdmin(storeId)
          || (isStoreMember(storeId)
            && get(storeUserPath(storeId, request.auth.uid)).data.role
              == 'EMPLOYEE'
            && resource.data.isActive == true);

        allow create: if validCompanyCreate(storeId, companyId);
        allow update: if validCompanyUpdate(storeId, companyId);
        allow delete: if false;
      }

      match /companyNameKeys/{normalizedNameKey} {
        allow get: if isAdmin(storeId);
        allow list: if false;
        allow create: if validCompanyNameClaimCreate(
          storeId, normalizedNameKey
        );
        allow update: if false;
        allow delete: if validCompanyNameClaimDelete(
          storeId, normalizedNameKey
        );
      }

      // ---------- Products ----------

      match /products/{productId} {
        allow get, list: if isStoreMember(storeId);

        // Creation is valid only when the price, cost, both uniqueness claims,
        // and both initial history records are written in this same batch.
        allow create: if validInitialProduct(storeId, productId);

        allow update: if isAdmin(storeId)
          && request.resource.data.keys().hasAll(['name', 'barcode', 'createdAt', 'updatedAt'])
          && request.resource.data.keys().hasOnly(['name', 'barcode', 'createdAt', 'updatedAt'])
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'barcode', 'updatedAt'])
          && request.resource.data.name is string
          && request.resource.data.name == request.resource.data.name.trim()
          && request.resource.data.name.matches('.*\\S.*')
          && request.resource.data.name.size() <= 120
          && request.resource.data.barcode is string
          && request.resource.data.barcode != ''
          && request.resource.data.barcode == request.resource.data.barcode.trim()
          && request.resource.data.barcode.size() <= 128
          && request.resource.data.updatedAt == request.time
          && validProductNameClaimAfter(
            storeId, productId, resource.data.name, request.resource.data.name
          )
          && validProductBarcodeClaimAfter(
            storeId, productId, resource.data.barcode, request.resource.data.barcode
          );
        allow delete: if false;
      }

      match /productNameKeys/{key} {
        // Used by name-prefix search. Rules evaluate every returned claim.
        allow get, list: if isStoreMember(storeId);
        allow create: if validNameClaimCreate(storeId, key);
        allow delete: if isAdmin(storeId)
          && existsAfter(productPath(storeId, resource.data.productId))
          && normalizedProductName(
            getAfter(productPath(storeId, resource.data.productId)).data.name
          ) != resource.data.normalizedName;
        allow update: if false;
      }

      match /productBarcodeKeys/{key} {
        allow get, list: if isAdmin(storeId);
        allow create: if validBarcodeClaimCreate(storeId, key);
        allow delete: if isAdmin(storeId)
          && existsAfter(productPath(storeId, resource.data.productId))
          && getAfter(productPath(storeId, resource.data.productId)).data.barcode
            != resource.data.barcode;
        allow update: if false;
      }

      match /productSellingPrices/{productId} {
        allow get, list: if isStoreMember(storeId);

        allow create: if isAdmin(storeId)
          && hasOnlyKeys(request.resource.data, [
            'sellingPrice', 'revision', 'updatedAt', 'updatedBy'
          ])
          && request.resource.data.sellingPrice is int
          && request.resource.data.sellingPrice > 0
          && request.resource.data.revision == 1
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy == request.auth.uid
          && getAfter(productPath(storeId, productId)).data.createdAt == request.time
          && validPriceHistoryLink(storeId,
            productId + '_SELLING_1', {
              'productId': productId, 'priceType': 'SELLING',
              'price': request.resource.data.sellingPrice, 'revision': 1,
              'createdBy': request.auth.uid, 'createdAt': request.time
            });

        allow update: if isAdmin(storeId)
          && hasOnlyKeys(request.resource.data, [
            'sellingPrice', 'revision', 'updatedAt', 'updatedBy'
          ])
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['sellingPrice', 'revision', 'updatedAt', 'updatedBy'])
          && request.resource.data.sellingPrice is int
          && request.resource.data.sellingPrice > 0
          && request.resource.data.sellingPrice != resource.data.sellingPrice
          && request.resource.data.revision == resource.data.revision + 1
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy == request.auth.uid
          && validPriceHistoryLink(storeId,
            productId + '_SELLING_' + string(request.resource.data.revision), {
              'productId': productId, 'priceType': 'SELLING',
              'price': request.resource.data.sellingPrice,
              'revision': request.resource.data.revision,
              'createdBy': request.auth.uid, 'createdAt': request.time
            });
        allow delete: if false;
      }

      match /productCosts/{productId} {
        // Purchase cost is private to Admin members.
        allow get, list: if isAdmin(storeId);

        allow create: if isAdmin(storeId)
          && hasOnlyKeys(request.resource.data, [
            'purchasePrice', 'revision', 'updatedAt', 'updatedBy'
          ])
          && request.resource.data.purchasePrice is int
          && request.resource.data.purchasePrice >= 0
          && request.resource.data.revision == 1
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy == request.auth.uid
          && getAfter(productPath(storeId, productId)).data.createdAt == request.time
          && validPriceHistoryLink(storeId,
            productId + '_PURCHASE_1', {
              'productId': productId, 'priceType': 'PURCHASE',
              'price': request.resource.data.purchasePrice, 'revision': 1,
              'createdBy': request.auth.uid, 'createdAt': request.time
            });

        allow update: if isAdmin(storeId)
          && hasOnlyKeys(request.resource.data, [
            'purchasePrice', 'revision', 'updatedAt', 'updatedBy'
          ])
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['purchasePrice', 'revision', 'updatedAt', 'updatedBy'])
          && request.resource.data.purchasePrice is int
          && request.resource.data.purchasePrice >= 0
          && request.resource.data.purchasePrice != resource.data.purchasePrice
          && request.resource.data.revision == resource.data.revision + 1
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy == request.auth.uid
          && validPriceHistoryLink(storeId,
            productId + '_PURCHASE_' + string(request.resource.data.revision), {
              'productId': productId, 'priceType': 'PURCHASE',
              'price': request.resource.data.purchasePrice,
              'revision': request.resource.data.revision,
              'createdBy': request.auth.uid, 'createdAt': request.time
            });
        allow delete: if false;
      }

      match /priceHistory/{historyId} {
        allow get, list: if isAdmin(storeId);
        allow create: if isAdmin(storeId)
          && validPriceHistoryLink(storeId, historyId, request.resource.data);
        allow update, delete: if false;
      }


      // ---------- Future store collections ----------

      match /{document=**} {
        allow read, write: if false;
      }
    }
  }
}
