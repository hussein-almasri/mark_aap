rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Common helpers ----------

    function isSignedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function membershipIndexPath(uid, storeId) {
      return /databases/$(database)/documents/users/$(uid)/memberships/$(storeId);
    }

    function storeUserPath(storeId, uid) {
      return /databases/$(database)/documents/stores/$(storeId)/users/$(uid);
    }

    function isStoreMember(storeId) {
      return isSignedIn()
        && exists(userPath(request.auth.uid))
        && exists(membershipIndexPath(request.auth.uid, storeId))
        && exists(storeUserPath(storeId, request.auth.uid))
        && get(membershipIndexPath(request.auth.uid, storeId)).data.storeId == storeId
        && get(membershipIndexPath(request.auth.uid, storeId)).data.isActive == true
        && get(storeUserPath(storeId, request.auth.uid)).data.uid == request.auth.uid
        && get(storeUserPath(storeId, request.auth.uid)).data.isActive == true;
    }

    function isAdmin(storeId) {
      return isStoreMember(storeId)
        && get(storeUserPath(storeId, request.auth.uid)).data.role == 'ADMIN';
    }

    // ---------- Global user ----------

    match /users/{uid} {
      // A user can read only their own account document.
      allow get: if isSignedIn()
        && request.auth.uid == uid;

      allow list: if false;

      // Account creation is handled by Cloud Functions.
      allow create: if false;

      // Users may update only their own display information.
      // Store role/status is NOT kept here.
      allow update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'displayName',
            'email',
            'updatedAt'
          ]);

      allow delete: if false;


      // ---------- Membership index ----------

      match /memberships/{storeId} {
        // The client may read its own membership index entry.
        allow get: if isSignedIn()
          && request.auth.uid == uid
          && resource.data.storeId == storeId;

        // The parent path limits this query to the signed-in user's index.
        allow list: if isSignedIn()
          && request.auth.uid == uid;

        // Memberships are created/changed by trusted backend/admin flows.
        allow create, update, delete: if false;
      }
    }


    // ---------- Stores ----------

    match /stores/{storeId} {
      // Any active member may read the store itself.
      allow get: if isStoreMember(storeId);

      allow list: if false;

      // Store creation is handled by Cloud Functions.
      allow create: if false;

      // Only Admin may update store data.
      allow update: if isAdmin(storeId)
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'name',
            'updatedAt'
          ]);

      allow delete: if false;


      // ---------- Store memberships ----------

      match /users/{uid} {
        // Members may read membership records.
        allow get: if isStoreMember(storeId);

        allow list: if false;

        // Membership creation/status/role changes are trusted operations.
        allow create, update, delete: if false;
      }


      // ---------- Future store collections ----------

      match /{document=**} {
        allow read, write: if false;
      }
    }
  }
}
